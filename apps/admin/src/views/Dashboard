<template>
  <div class="dashboard">
    <h1>Дашборд</h1>
    
    <div class="stats-grid">
      <div class="stat-card">
        <h3>Товары</h3>
        <p class="stat-number">{{ productsCount }}</p>
      </div>
      <div class="stat-card">
        <h3>Заказы</h3>
        <p class="stat-number">{{ ordersCount }}</p>
      </div>
      <div class="stat-card">
        <h3>Новости</h3>
        <p class="stat-number">{{ newsCount }}</p>
      </div>
      <div class="stat-card">
        <h3>Акции</h3>
        <p class="stat-number">{{ promotionsCount }}</p>
      </div>
    </div>

    <div class="recent-orders">
      <h2>Последние заказы</h2>
      <div v-if="recentOrders.length === 0" class="no-data">
        <p>Нет заказов</p>
      </div>
      <div v-else class="orders-table">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Пользователь</th>
              <th>Сумма</th>
              <th>Статус</th>
              <th>Дата</th>
            </tr>
          </thead>
          <tbody>
            <tr v-for="order in recentOrders" :key="order.id">
              <td>{{ order.id }}</td>
              <td>{{ order.email }}</td>
              <td>{{ formatPrice(order.total) }} ₽</td>
              <td>
                <span class="status" :class="order.status">{{ getStatusText(order.status) }}</span>
              </td>
              <td>{{ formatDate(order.created_at) }}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</template>

<script>
import { computed, onMounted } from 'vue'
import { useStore } from 'vuex'

export default {
  name: 'Dashboard',
  setup() {
    const store = useStore()

    const productsCount = computed(() => store.state.products.length)
    const ordersCount = computed(() => store.state.orders.length)
    const newsCount = computed(() => store.state.news.length)
    const promotionsCount = computed(() => store.state.promotions.length)
    const recentOrders = computed(() => store.state.orders.slice(0, 5))

    const formatPrice = (price) => {
      return new Intl.NumberFormat('ru-RU').format(price)
    }

    const formatDate = (dateString) => {
      return new Date(dateString).toLocaleDateString('ru-RU')
    }

    const getStatusText = (status) => {
      const statuses = {
        pending: 'Ожидает',
        processing: 'В обработке',
        completed: 'Завершен',
        cancelled: 'Отменен'
      }
      return statuses[status] || status
    }

    onMounted(() => {
      store.dispatch('fetchProducts')
      store.dispatch('fetchOrders')
      store.dispatch('fetchNews')
      store.dispatch('fetchPromotions')
    })

    return {
      productsCount,
      ordersCount,
      newsCount,
      promotionsCount,
      recentOrders,
      formatPrice,
      formatDate,
      getStatusText
    }
  }
}
</script>

